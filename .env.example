# Resend - create at https://resend.com/api-keys (new account)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives consultation + career emails
# IMPORTANT while using onboarding@resend.dev:
# Must be the SAME email you used to sign up for Resend.
CONTACT_TO_EMAIL=your-resend-signup@email.com

# Optional: separate inbox for job applications only
# (requires verified domain - cannot use a different address with onboarding@resend.dev)
# CAREERS_TO_EMAIL=careers@yourdomain.com

# Sender
# Testing (no domain yet):
RESEND_FROM_EMAIL=onboarding@resend.dev
# Production (after Domains → verify nzoinnovations.com):
# RESEND_FROM_EMAIL=nZO Innovations <hello@nzoinnovations.com>
